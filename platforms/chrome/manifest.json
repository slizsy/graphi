{
  "manifest_version": 3,
  "name": "Graphi — Human Auto Typer",
  "short_name": "Graphi",
  "version": "1.3.0",
  "description": "Types your text into Google Docs, Slides and almost any web text field — keystroke by keystroke, at a natural human rhythm.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Graphi",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "24": "icons/toolbar-24.png",
      "32": "icons/toolbar-32.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "incognito": "spanning",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/Geist-Variable.woff2", "assets/fonts/GeistMono-Variable.woff2"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Open Graphi"
    },
    "toggle-typing": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Start, pause or resume typing"
    },
    "stop-typing": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Stop typing"
    }
  }
}
